# =============================================================================
# Cogitate environment configuration — GENERATED, DO NOT EDIT
# =============================================================================
#
# The app runs with no .env at all: every key below has a default, and the
# defaults are declared in backend/app/core/config.py. Values here exist so a
# fresh install can be tuned without reading the source.
#
# To configure: cp .env.example .env, then set only what you need. `.env` is
# gitignored — it is the only place a secret belongs.
#
# Regenerate with `python3 scripts/dev/generate_env_example.py`; `--check` runs
# in the pre-commit hook and the flat-tree gates, so a hand edit fails.

# ---------------------------------------------------------------------------
# App identity and server
# ---------------------------------------------------------------------------

# str · default: Cogitate
APP_NAME=Cogitate

# str · default: 0.1.1
APP_VERSION=0.1.1

# bool · default: true
DEBUG=true

# str · default: development
ENVIRONMENT=development

# str · default: 0.0.0.0
HOST=0.0.0.0

# int · default: 8000
PORT=8000

# ---------------------------------------------------------------------------
# Startup work
# ---------------------------------------------------------------------------

# bool · default: false
STARTUP_SWEEP_ENABLED=false

# bool · default: false
EXA_BACKGROUND_PROCESSING_ENABLED=false

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------

# str · derived from the project root
# DATABASE_URL=

# str · derived from the project root
# DOCUMENTS_DATABASE_URL=

# bool · default: false
DB_ECHO=false

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# list[str] · default: ["http://localhost:5173", "http://localhost:5174", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:5174", "http://127.0.0.1:3000"]
CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:5174", "http://127.0.0.1:3000"]

# bool · default: true
CORS_ALLOW_CREDENTIALS=true

# list[str] · default: ["*"]
CORS_ALLOW_METHODS=["*"]

# list[str] · default: ["*"]
CORS_ALLOW_HEADERS=["*"]

# ---------------------------------------------------------------------------
# Provider API keys
# ---------------------------------------------------------------------------

# str · secret: `.env` only, never committed
OPENAI_API_KEY=

# str · secret: `.env` only, never committed
ANTHROPIC_API_KEY=

# str · secret: `.env` only, never committed
OPENROUTER_API_KEY=

# str · secret: `.env` only, never committed
DEEPSEEK_API_KEY=

# str · secret: `.env` only, never committed
GROQ_API_KEY=

# str · secret: `.env` only, never committed
OLLAMA_CLOUD_API_KEY=

# str · secret: `.env` only, never committed
TAVILY_API_KEY=

# str · secret: `.env` only, never committed
LITELLM_MASTER_KEY=

# ---------------------------------------------------------------------------
# Default provider and model
# ---------------------------------------------------------------------------

# str · default: (empty) — read by nothing; a capability or a provider row answers instead
DEFAULT_LLM_PROVIDER=

# str · default: (empty) — read by nothing; the model belongs to the capability or the row
DEFAULT_LLM_MODEL=

# ---------------------------------------------------------------------------
# Tracing
# ---------------------------------------------------------------------------

# str · secret: `.env` only, never committed
LANGFUSE_PUBLIC_KEY=

# str · secret: `.env` only, never committed
LANGFUSE_SECRET_KEY=

# str · default: (empty)
LANGFUSE_BASE_URL=

# str · default: (empty)
LANGFUSE_HOST=

# str · default: (empty) — the environment tag traces carry; unset means development
LANGFUSE_ENVIRONMENT=

# bool | None · unset: resolved in code
# LANGFUSE_TRACING_ENABLED=

# ---------------------------------------------------------------------------
# Encryption
# ---------------------------------------------------------------------------

# str · secret: `.env` only, never committed
COGITATE_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Sync, uploads and files
# ---------------------------------------------------------------------------

# int · default: 168
DEFAULT_SYNC_INTERVAL_HOURS=168

# int · default: 5242880
MAX_UPLOAD_SIZE=5242880

# int · default: 2097152
MAX_SOUND_UPLOAD_SIZE=2097152

# list[str] · default: ["image/jpeg", "image/png", "image/gif", "image/webp"]
ALLOWED_IMAGE_TYPES=["image/jpeg", "image/png", "image/gif", "image/webp"]

# list[str] · default: ["audio/wav", "audio/x-wav", "audio/wave"]
ALLOWED_SOUND_TYPES=["audio/wav", "audio/x-wav", "audio/wave"]

# str · derived from the project root
# PROFILE_IMAGES_DIR=

# ---------------------------------------------------------------------------
# Logging and cache
# ---------------------------------------------------------------------------

# str · default: INFO
LOG_LEVEL=INFO

# str · derived from the project root
# LOG_FILE=

# int · default: 300
CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Local models
# ---------------------------------------------------------------------------

# str · default: (empty)
LLAMA_MODEL_PATH=

# ---------------------------------------------------------------------------
# Other settings
# ---------------------------------------------------------------------------

# int · default: 100000
INPUT_TOKEN_BUDGET=100000

# ---------------------------------------------------------------------------
# Read outside Settings — no model declares these, so they are listed by hand
# ---------------------------------------------------------------------------

# the backend origin the browser talks to; unset means same origin
# reader: frontend/src/services/apiClient.ts (build-time, via import.meta.env)
# VITE_API_URL=

# the backend's own origin, used by tools that call back into the API
# reader: backend/app/domain/tools/registry.py
# COGITATE_BACKEND_URL=

# the token a declarative tool presents when it calls back
# reader: backend/app/domain/tools/declarative.py
# COGITATE_DECLARATIVE_TOOL_TOKEN=

# the drain's period; the code default is 900
# reader: backend/app/main.py (cogitate.sh passes 20 for development)
# INBOX_PROCESSOR_INTERVAL_SECONDS=

# the boot sweep's delay; the code default is 60
# reader: backend/app/main.py (cogitate.sh passes 15 for development)
# SYSTEM_SWEEP_DELAY_SECONDS=

# the checkpoint store's database
# reader: backend/app/workflows/checkpointing/config.py
# WORKFLOW_DB_URL=

# whether session titles are generated at all
# reader: backend/app/domain/title/services.py
# TITLE_LLM_ENABLED=

# the title call's token ceiling; the code default is 128
# reader: backend/app/domain/title/services.py
# TITLE_LLM_MAX_TOKENS=

# the title call's temperature; the code default is 0.3
# reader: backend/app/domain/title/services.py
# TITLE_LLM_TEMPERATURE=
