backend/secrets.yaml

# Local-only documentation (not for publication)
docs/local/

# Runtime data
data/

# Project trash / cleanup staging area — ANCHORED, so the pattern does not also
# swallow a SOURCE directory named `trash` (the domain package at
# backend/app/domain/trash is code, not staging).
/trash/

# Local-only development content (not for publication)
local/

# The external agent's private Hermes home (per-install state —
# provisioned by scripts/core/provision_exa_home.py)
.hermes/
.exa-workspace/

# Virtual environment (root level)
.venv/

# Python tool caches
.ruff_cache/
.pytest_cache/

# Node modules (project root)
node_modules/

# Artifact files
.FullName
START_APP.sh
agents/.archived/
agents/*/vector_index/

# Agent workspaces (untracked by design — the owned folders are local state)
agents/*/

# THE INSTALLATION'S ENCRYPTION KEY (generated on first run at data/.encryption_key).
# A secret that decrypts the provider keys stored in the database.
.encryption_key

# The SQLite database + its backups (keys+DB live in the project root, local only)
cogitate.db
cogitate.db.*

# Our todos — the backlog, the done records and the issue bank. These are the
# team's working notes, not product, and they ship nowhere: tracked until
# 2026-11-17, untracked from then (`git rm -r --cached todo`). They stay on disk
# beside `local/`.
todo/

# Trash (pre-delete staging)
_trash/
# NOTE: `scripts/dev/` is NOT ignored. It holds shipped tools only
# (vite-supervisor.sh is spawned by cogitate.sh; the rest are dev utilities),
# and a directory pattern silently drops tracked files from a flatten —
# `__pycache__/` and `*.log` above cover the actual scratch.

# The launcher's unmanaged capture directory (2026-09-12).
# `*.log` was already listed but not the rotation artefacts (*.log.1.gz),
# so a rotated capture could be committed by accident. Nothing in logs/ is
# source: it is runtime output.
/logs/

# A dev-machine sandbox helper with hardcoded paths — stays local.
scripts/dev/setup_boss_sandbox.sh
